{
  "meta": { "name": "Crucible Curve", "version": 2 },
  "artboard": {
    "width": 1920,
    "height": 1080,
    "padding": { "top": 150, "right": 120, "bottom": 120, "left": 130 },
    "background": { "color": "#05070d", "haze": true, "vignette": true }
  },
  "style": {
    "gridX": 12,
    "gridY": 8,
    "gridColor": "#2a3556",
    "gridOpacity": 0.18,
    "axisColor": "#5b6b94",
    "guideColor": "#33406a",
    "labelColor": "#8fa0c8"
  },
  "theme": "crucible-neon",
  "mode": "dark",
  "axes": { "xLabel": "TRANSFORMATION PROGRESS", "yLabel": "RELATIVE LEVEL", "yLow": "Low", "yHigh": "High", "showTicks": true },
  "layers": [
    { "id": "primary", "name": "Phase 1 · Primary Crucible" },
    { "id": "decline", "name": "Phase 2 · Complacency / Decline" },
    { "id": "renewal", "name": "Phase 2 · Renewing the Crucible" }
  ],
  "title": { "show": false, "x": 0.5, "y": 1.05, "fontSize": 56, "color": "#ffffff", "glow": true, "bold": true, "align": "middle" },
  "regions": {
    "enabled": true,
    "branchX": 0.605,
    "branch": { "x": 0.605, "y": 0.89, "show": true },
    "divider": true,
    "tint": true
  },
  "milestones": [
    { "id": "ms-excitement",  "label": "Excitement",       "x": 0.04, "showGuide": true,  "phase": "primary", "group": "primary" },
    { "id": "ms-friction",    "label": "Reality Friction", "x": 0.17, "showGuide": true,  "phase": "primary", "group": "primary" },
    { "id": "ms-persistence", "label": "Persistence",      "x": 0.31, "showGuide": true,  "phase": "primary", "group": "primary" },
    { "id": "ms-proficiency", "label": "Proficiency",      "x": 0.45, "showGuide": true,  "phase": "primary", "group": "primary" },
    { "id": "ms-mastery",     "label": "Mastery",          "x": 0.57, "showGuide": true,  "phase": "primary", "group": "primary" },

    { "id": "ms-complacency", "label": "COMPLACENCY",           "x": 0.80, "y": 0.99, "showGuide": false, "phase": "post", "group": "decline", "optional": true, "color": "#22d3ee" },
    { "id": "ms-renewcap",    "label": "RENEWING THE CRUCIBLE", "x": 0.77, "y": 0.40, "showGuide": false, "phase": "post", "group": "renewal", "optional": true, "color": "#ffb24d" },

    { "id": "ms-comfort",     "label": "Comfort",     "x": 0.66, "y": 0.50, "showGuide": false, "phase": "post", "group": "decline" },
    { "id": "ms-bureaucracy", "label": "Bureaucracy", "x": 0.75, "y": 0.50, "showGuide": false, "phase": "post", "group": "decline" },
    { "id": "ms-stagnation",  "label": "Stagnation",  "x": 0.84, "y": 0.50, "showGuide": false, "phase": "post", "group": "decline" },
    { "id": "ms-decline",     "label": "Decline",     "x": 0.95, "y": 0.50, "showGuide": false, "phase": "post", "group": "decline" },

    { "id": "ms-newcost",     "label": "New Cost",              "x": 0.70, "y": 0.30, "showGuide": false, "phase": "post", "group": "renewal" },
    { "id": "ms-newresist",   "label": "New Resistance",        "x": 0.79, "y": 0.30, "showGuide": false, "phase": "post", "group": "renewal" },
    { "id": "ms-tempdip",     "label": "Temporary Dip",         "x": 0.87, "y": 0.30, "showGuide": false, "phase": "post", "group": "renewal" },
    { "id": "ms-futureval",   "label": "Future Value Creation", "x": 0.96, "y": 0.30, "showGuide": false, "phase": "post", "group": "renewal" }
